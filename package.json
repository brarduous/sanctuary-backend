{
  "name": "sanctuary-backend",
  "version": "1.0.0",
  "description": "Backend for AI content generation and database interaction.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dev:staging": "node scripts/devStaging.js",
    "precron-outlook": "npx puppeteer browsers install chrome",
    "cron-outlook": "node cron/generateScripturalOutlook.js",
    "test:news-sources": "node scripts/testNewsSources.js",
    "cron-daily-news": "node cron/dailyNewsSynopsis.js",
    "refresh-taxonomy-breakdowns": "node scripts/refreshTaxonomyBreakdowns.js",
    "backfill-news-impact": "node scripts/backfillNewsImpactScores.js",
    "backfill-news-verification": "node scripts/backfillRecentNewsVerification.js",
    "backfill-cbs-news-images": "node scripts/backfillCbsNewsImages.js",
    "backfill-news-clusters": "node scripts/backfillNewsClusters.js",
    "replay-news-gap": "node scripts/replayNewsGap.js",
    "generate-devotional-syllabus": "node scripts/generateSyllabus.js",
    "cron-general-devotionals": "node cron/generateGeneralDevotionals.js",
    "cron-church-content": "node cron/dispatchChurchContent.js",
    "seed-demo": "node scripts/resetDemoData.js",
    "seed:congregation-demo": "node scripts/seedCongregationDemoData.js",
    "reset:production-account": "node scripts/resetProductionAccount.js",
    "backfill-congregation-crm": "node scripts/backfillCongregationCrmProfiles.js",
    "curate-music-library": "node scripts/curateMusicLibrary.js",
    "curate-videos": "node scripts/curateVideos.js",
    "import-youtube-channels": "node scripts/importYoutubeChannelsFromXlsx.js",
    "evaluate-prompts": "node scripts/evaluatePrompts.js",
    "evaluate:pastor-voice": "node scripts/evaluatePastorVoice.js",
    "review:pastor-voice-eval": "node scripts/createPastorVoiceReviewPacket.js",
    "cleanup:pastor-voice-eval": "node scripts/cleanupPastorVoiceEvaluation.js",
    "test": "node --test test/**/*.test.js test/*.test.js",
    "typecheck": "node --check index.js && find middleware routes utils -name '*.js' -print0 | xargs -0 -n1 node --check",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local > types/database.generated.ts",
    "db:production:preflight": "node scripts/productionDatabase.js preflight",
    "db:production:rollback": "node scripts/productionDatabase.js rollback",
    "test:message-isolation:staging": "node scripts/verifyMessageIsolation.js",
    "test:checkin-journey:staging": "node scripts/verifyCheckinJourney.js",
    "test:event-volunteer-journey:staging": "node scripts/verifyEventVolunteerJourney.js",
    "test:content-production:staging": "node scripts/verifyContentProductionJourney.js",
    "test:staging": "node scripts/verifyStaging.js",
    "test:production-shape": "node scripts/verifyProductionShape.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^1.8.0",
    "@mux/mux-node": "^12.8.1",
    "@supabase/supabase-js": "^2.57.2",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "expo-server-sdk": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^170.1.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.11",
    "openai": "^5.10.1",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.22.3",
    "sharp": "^0.35.3",
    "stripe": "^20.0.0",
    "web-push": "^3.6.7",
    "xml2js": "^0.6.2",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "xlsx": "^0.18.5"
  }
}
